---
import FooterLogin from "../components/Footer_Login.astro";
import "../styles/globals.css";

const { title } = Astro.props;
---

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    background-color: white;

    padding: 0;
    margin: 0;

    align-items: center;
  }

  .logo {
    height: 120px;
    width: 120px;
  }

  main {
    padding: 50px 0 50px 0;
    background-color: var(--base);
    /* flex: 3; */
    /* flex: 0; */
    min-height: 750px;
    max-height: 750px;
    height: 750px;
    max-width: 100%;
  }

  .spacer {
    flex: 1;
  }

  .box {
    height: 400px;
    width: 400px;
    max-width: 400px;
    max-height: 400px;
    background-color: white;
    border-radius: 5px;
    box-shadow: 0px 10px 15px -3px rgba(0, 0, 0, 0.1);
    position: relative;
    transition: transform 0.2s;
  }
  .box span {
    position: absolute;
    transform: translate(50%, 50%);
    bottom: 50%;
    right: 50%;
  }
  .box:hover {
    transform: scale(1.05);
  }
</style>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="spacer"></div>
    <main>
      <slot />
    </main>
    <div class="spacer"></div>
    <FooterLogin />
  </body>
</html>
